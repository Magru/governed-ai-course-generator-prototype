# Names only. Never commit values.
# AWS credentials live in ~/.aws/bedrock-personal, never in this file.

BEDROCK_ACCOUNT_ID=          # required, no default; the run refuses if identity differs
AWS_PROFILE=bedrock
AWS_SHARED_CREDENTIALS_FILE=
AWS_CONFIG_FILE=
AWS_REGION=us-east-1

# Inference-profile ids only. A bare model id returns ResourceNotFoundException.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=        # created by hand in the console; until then screening refuses
BEDROCK_GUARDRAIL_VERSION=

GEMINI_API_KEY=              # read from ~/.claude/.env in development
